OPENAI_API_KEY=your_openai_api_key

ELEVENLABS_API_KEY=your_elevenlabs_api_key

SIXTYDB_API_KEY=your_60db_api_key

# Primary TTS provider: "60db" or "elevenlabs". The other is used as fallback.
TTS_PROVIDER=60db

# Optional: a specific 60db voice_id (UUID). Leave unset to use the system default.
# SIXTYDB_VOICE_ID=
